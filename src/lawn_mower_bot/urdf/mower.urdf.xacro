<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="lawn_mower_bot">

    <xacro:property name="chassis_mass" value="2.0"/> <xacro:property name="wheel_mass" value="0.5"/>
    <xacro:property name="wheel_radius" value="0.07"/>
    <xacro:property name="wheel_separation" value="0.36"/>
    <xacro:property name="wheel_width" value="0.04"/>

    <link name="base_link">
        <visual>
            <origin xyz="0 0 0.05" rpy="0 0 0"/>
            <geometry>
                <box size="0.4 0.3 0.1"/>
            </geometry>
            <material name="green">
                <color rgba="0.0 0.8 0.0 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0.05" rpy="0 0 0"/>
            <geometry>
                <box size="0.4 0.3 0.1"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0.05" rpy="0 0 0"/>
            <mass value="${chassis_mass}"/>
            <inertia ixx="0.083" ixy="0.0" ixz="0.0" iyy="0.142" iyz="0.0" izz="0.208"/>
        </inertial>
    </link>

    <link name="base_footprint">
        <inertial>
            <mass value="0.0001"/>
            <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
        </inertial>
    </link>

    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
    </joint>

    <link name="imu_link">
      <inertial>
        <mass value="0.01"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>
    <joint name="imu_joint" type="fixed">
      <parent link="base_link"/>
      <child link="imu_link"/>
    </joint>

    <link name="caster_front_wheel">
        <visual>
            <geometry>
                <sphere radius="0.03"/>
            </geometry>
            <material name="white">
                <color rgba="1.0 1.0 1.0 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <sphere radius="0.03"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.1"/>
            <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
        </inertial>
    </link>

    <joint name="caster_front_joint" type="fixed">
        <parent link="base_link"/>
        <child link="caster_front_wheel"/>
        <origin xyz="0.15 0 -0.04" rpy="0 0 0"/>
    </joint>

    <gazebo reference="caster_front_wheel">
        <mu1>0.0</mu1>
        <mu2>0.0</mu2>
        <material>Gazebo/White</material>
    </gazebo>

    <xacro:macro name="wheel_link" params="prefix">
        <link name="${prefix}_wheel">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
                <origin rpy="1.5707 0 0" xyz="0 0 0"/>
                <material name="black">
                    <color rgba="0.1 0.1 0.1 1.0"/>
                </material>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
                 <origin rpy="1.5707 0 0" xyz="0 0 0"/>
            </collision>
            <inertial>
                <mass value="${wheel_mass}"/>
                <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
            </inertial>
        </link>
    </xacro:macro>

    <xacro:wheel_link prefix="left"/>
    <xacro:wheel_link prefix="right"/>

    <joint name="left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel"/>
        <origin xyz="-0.1 ${wheel_separation/2} 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit effort="50.0" velocity="10.0"/>
    </joint>

    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel"/>
        <origin xyz="-0.1 -${wheel_separation/2} 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit effort="50.0" velocity="10.0"/>
    </joint>

    <gazebo reference="left_wheel">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
    </gazebo>
    <gazebo reference="right_wheel">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
    </gazebo>

    <link name="camera_link">
        <visual>
            <geometry>
                <box size="0.05 0.1 0.05"/>
            </geometry>
            <material name="black">
                <color rgba="0.1 0.1 0.1 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.05 0.1 0.05"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.1"/>
            <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
        </inertial>
    </link>

    <!-- Mount camera at front and top of chassis block -->
    <joint name="camera_joint" type="fixed">
        <parent link="base_link"/>
        <child link="camera_link"/>
        <origin xyz="0.18 0 0.12" rpy="0 0.1 0"/> <!-- pitched slightly down -->
    </joint>

    <gazebo reference="camera_link">
        <sensor type="camera" name="front_camera">
            <update_rate>30.0</update_rate>
            <always_on>true</always_on>
            <visualize>true</visualize>
            <topic>/camera/image_raw</topic>
            <camera>
                <horizontal_fov>1.047198</horizontal_fov> <!-- 60 degrees -->
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>20.0</far>
                </clip>
            </camera>
        </sensor>
    </gazebo>

    <!-- LIDAR SENSOR -->
    <link name="lidar_link">
        <visual>
            <geometry>
                <cylinder radius="0.04" length="0.05"/>
            </geometry>
            <material name="blue">
                <color rgba="0.0 0.0 0.8 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.04" length="0.05"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.2"/>
            <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
        </inertial>
    </link>

    <joint name="lidar_joint" type="fixed">
        <parent link="base_link"/>
        <child link="lidar_link"/>
        <origin xyz="0 0 0.20" rpy="0 0 0"/> 
    </joint>

    <gazebo reference="lidar_link">
        <sensor name='gpu_lidar' type='gpu_lidar'>
            <gz_frame_id>lidar_link</gz_frame_id>
            <topic>scan</topic>
            <update_rate>10</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>640</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.15</min>
                    <max>12.0</max>
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </ray>
            <always_on>1</always_on>
            <visualize>false</visualize>
        </sensor>
    </gazebo>

    <gazebo>
        <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
             <render_engine>ogre2</render_engine>
        </plugin>
        <plugin name="gz::sim::systems::DiffDrive" filename="gz-sim-diff-drive-system">
            <left_joint>left_wheel_joint</left_joint>
            <right_joint>right_wheel_joint</right_joint>
            <wheel_separation>${wheel_separation}</wheel_separation>
            <wheel_radius>${wheel_radius}</wheel_radius>
            <topic>/cmd_vel</topic>
            <odom_topic>/odom</odom_topic>
            <frame_id>odom</frame_id>
            <child_frame_id>base_footprint</child_frame_id>
            <publish_odom>true</publish_odom>
            <publish_odom_tf>false</publish_odom_tf> 
            <publish_wheel_tf>true</publish_wheel_tf>
        </plugin>
        <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system">
            <topic>/imu/data</topic>
            <frame_id>imu_link</frame_id>
        </plugin>
        <plugin name="gz::sim::systems::NavSat" filename="gz-sim-navsat-system">
            <topic>/gps/fix</topic>
            <frame_id>base_link</frame_id>
        </plugin>
        <plugin name="gz::sim::systems::JointStatePublisher" filename="gz-sim-joint-state-publisher-system">
            <topic>/joint_states</topic>
        </plugin>
        
        <plugin filename="gz-sim-particle-emitter-system" name="gz::sim::systems::ParticleEmitter">
        </plugin>
        
        <!-- The Projector plugin allows us to project a texture onto the environment -->
        <plugin filename="gz-sim-projector-system" name="gz::sim::systems::Projector">
        </plugin>
    </gazebo>

    <!-- MOWED GRASS PROJECTOR (Paints the ground dark green) -->
    <gazebo reference="base_link">
        <projector name="mower_painter">
            <pose>0 0 0.1 0 1.5707 0</pose>
            <fov>1.0</fov>
            <near_clip>0.01</near_clip>
            <far_clip>1.0</far_clip>
            <visibility_flags>0x01</visibility_flags>
        </projector>
    </gazebo>

    <!-- GRASS PARTICLE EMITTER (Simulates the blade cutting grass) -->
    <link name="blade_link">
        <pose>0 0 0.02 0 0 0</pose>
    </link>
    <joint name="blade_joint" type="fixed">
        <parent link="base_link" />
        <child link="blade_link" />
        <origin xyz="-0.1 0 -0.05" rpy="0 0 0" />
    </joint>

    <gazebo reference="blade_link">
        <particle_emitter name="grass_emitter" type="box">
            <emitting>false</emitting>
            <size>0.3 0.2 0</size>
            <particle_size>0.02 0.02 0.02</particle_size>
            <lifetime>2.0</lifetime>
            <min_velocity>0.1</min_velocity>
            <max_velocity>0.3</max_velocity>
            <rate>200</rate>
            <scale_rate>0</scale_rate>
            <scatter_ratio>0.2</scatter_ratio>
            <material>
                <ambient>0.0 0.8 0.0 1.0</ambient>
                <diffuse>0.0 0.8 0.0 1.0</diffuse>
            </material>
            <topic>/mower_blade_state</topic>
        </particle_emitter>
    </gazebo>

</robot>